{
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/design.js": {
      "maxDuration": 60
    },
    "api/subscription.js": {
      "maxDuration": 180,
      "includeFiles": "{subscription/*.mjs,src/design-input.js,src/spec.js}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
